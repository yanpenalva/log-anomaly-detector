# Application
APP_ENV=development
APP_DEBUG=true
FLIGHT_BASE_URL=/
APP_TIMEZONE=UTC

# Database — env wins over config.php for these keys when set
# Drivers: sqlite | mysql | (empty to disable)
DB_DRIVER=
DB_HOST=localhost
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
# Absolute or project-relative path for SQLite
DB_SQLITE_PATH=

# Anomaly detection (optional overrides of config.php defaults)
#ANOMALY_EPSILON=0.35
#ANOMALY_MINIMUM_SAMPLES=5
