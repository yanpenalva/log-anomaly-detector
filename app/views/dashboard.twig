{% extends 'layout.twig' %}

{% block title %}Dashboard — log-anomaly-detector{% endblock %}

{% block body %}
<div class="card">
    <h1>Anomaly detection dashboard</h1>
    <p class="muted">
        Paste HTTP access logs, run <strong>DBSCAN</strong>, and inspect which requests are
        <span class="badge noise">noise = anomaly</span> versus
        <span class="badge ok">clustered = normal</span>.
        Everything runs locally against SQLite — no data leaves this machine.
    </p>
</div>

<div class="grid cols-2">
    <div class="card">
        <h2>
            Run analysis
            <span class="tooltip">?
                <span class="tip">Each log is converted to a 33-dimension vector: method (one-hot),
                endpoint (hash buckets), HTTP status class (one-hot 1xx–5xx) and raw
                response_time / request_size / hour. Vectors are min-max normalized,
                then clustered with DBSCAN.</span>
            </span>
        </h2>

        <div id="alert" class="alert"></div>

        <div class="field">
            <label>
                Logs (JSON array)
                <span class="tooltip">?
                    <span class="tip">Array of objects with: method, endpoint, status_code,
                    response_time (ms), request_size (bytes), hour (0–23).
                    Max 10,000 logs per request.</span>
                </span>
            </label>
            <textarea id="logs" spellcheck="false"></textarea>
        </div>

        <div class="row" style="margin-top: .8rem;">
            <div class="field">
                <label>
                    epsilon
                    <span class="tooltip">?
                        <span class="tip">Neighborhood radius (Euclidean distance on normalized
                        vectors). Points closer than epsilon are neighbors.
                        Bigger = fewer, larger clusters. Range 0.001–1000.</span>
                    </span>
                </label>
                <input type="number" id="epsilon" value="0.35" step="0.05" min="0.001" max="1000">
            </div>
            <div class="field">
                <label>
                    minimum_samples
                    <span class="tooltip">?
                        <span class="tip">Minimum neighbors (including the point itself) inside
                        epsilon for a point to be a core point. Lower = more sensitive
                        to small groups. Range 1–10,000.</span>
                    </span>
                </label>
                <input type="number" id="minSamples" value="5" step="1" min="1" max="10000">
            </div>
            <div class="field">
                <label>
                    Input format
                    <span class="tooltip">?
                        <span class="tip">auto: JSON array of log objects, CSV dataset text
                        (with the method,endpoint,... header) or nginx combined
                        access.log lines — detected automatically.</span>
                    </span>
                </label>
                <select id="format">
                    <option value="auto">auto</option>
                    <option value="csv">csv</option>
                    <option value="nginx">nginx</option>
                </select>
            </div>
            <button id="analyze">Analyze</button>
            <button id="project">Project &amp; scatter</button>
            <button class="ghost" id="loadSample">Load sample logs</button>
        </div>
    </div>

    <div class="card">
        <h2>How anomalies are decided</h2>
        <p class="muted" style="margin-top: 0;">
            DBSCAN is <strong>unsupervised</strong>: it never saw labels. A log is an
            anomaly when it is a <em>noise point</em> — its neighborhood is too sparse to
            belong to any cluster.
        </p>
        <ul class="muted" style="font-size: .88rem; padding-left: 1.2rem;">
            <li><strong>core point</strong> — ≥ minimum_samples neighbors within epsilon</li>
            <li><strong>cluster</strong> — core points + everything density-reachable</li>
            <li><strong>noise</strong> — in no cluster → reported as <code>anomaly</code></li>
        </ul>
        <p class="muted" style="font-size: .85rem;">
            There is intentionally <strong>no confidence score</strong>: DBSCAN does not
            produce probabilities, and the API does not invent them.
            <code>POST /api/v1/detect</code> returns 501 for the same reason — DBSCAN has
            no incremental inference.
        </p>
    </div>
</div>

<div class="card hidden" id="resultCard">
    <h2>
        Latest run
        <span class="badge run" id="runBadge">run #–</span>
    </h2>
    <div class="stats">
        <div class="stat">
            <div class="value" id="statSamples">–</div>
            <div class="label">samples
                <span class="tooltip">?
                    <span class="tip">Total number of log entries analyzed in this run.</span>
                </span>
            </div>
        </div>
        <div class="stat clusters">
            <div class="value" id="statClusters">–</div>
            <div class="label">clusters
                <span class="tooltip">?
                    <span class="tip">Dense traffic patterns found. Each cluster is a group of
                    requests that are mutually within epsilon of each other (density-reachable).</span>
                </span>
            </div>
        </div>
        <div class="stat anomalies">
            <div class="value" id="statAnomalies">–</div>
            <div class="label">anomalies (noise)
                <span class="tooltip">?
                    <span class="tip">Entries that ended up in no cluster. In this domain a
                    noise point IS the anomaly: its neighborhood is too sparse to be a
                    known traffic pattern.</span>
                </span>
            </div>
        </div>
    </div>

    <h2 style="margin-top: 1.4rem;">Anomalies</h2>
    <div id="anomalyTable"></div>
</div>

<div class="card hidden" id="vizCard">
    <h2>
        PCA projection
        <span class="badge run" id="vizBadge">2D</span>
    </h2>
    <p class="muted" style="margin-top: 0;">
        Same pipeline, same features, projected to 2D with PCA. Each dot is one log —
        <span class="badge noise">red = noise = anomaly</span>, colors are DBSCAN clusters.
    </p>
    <div id="vizMeta" class="muted" style="margin-bottom: .6rem;"></div>
    <div id="scatter" style="border: 1px solid var(--border); border-radius: 10px; background: #0b1018; padding: .6rem;"></div>
    <h2 style="margin-top: 1.2rem; font-size: 1rem;">k-distance curve <span class="muted" style="font-weight: 400;">(log scale — pick ε above the cliff, below the outliers)</span></h2>
    <div id="curveChart" style="border: 1px solid var(--border); border-radius: 10px; background: #0b1018; padding: .6rem;"></div>
</div>

<div class="grid cols-2">
    <div class="card">
        <h2>Algorithms used</h2>
        <p class="muted" style="margin-top: 0;">All techniques run through PHP-ML, wrapped behind domain ports — the domain never imports <code>Phpml\</code>.</p>
        <table>
            <thead><tr><th>Technique</th><th>Family</th><th>What it does here</th></tr></thead>
            <tbody>
                <tr>
                    <td><strong>DBSCAN</strong></td>
                    <td>density</td>
                    <td>Clusters logs by neighborhood density; noise points <em>are</em> the anomalies. The production detector.</td>
                </tr>
                <tr>
                    <td><strong>K-Means</strong></td>
                    <td>centroid</td>
                    <td>Study-only contrast: assigns every log to one of k centroids (no noise concept — small clusters stand in for anomalies).</td>
                </tr>
                <tr>
                    <td><strong>PCA</strong></td>
                    <td>reduction</td>
                    <td>Projects the ~33-dim feature space to 2D for the scatter plot, preserving maximum variance.</td>
                </tr>
                <tr>
                    <td><strong>Apriori</strong></td>
                    <td>association</td>
                    <td>Mines rule signatures among anomalies (CLI <code>php runway characterize</code>) and contrasts them with normal traffic.</td>
                </tr>
                <tr>
                    <td><strong>k-distance</strong></td>
                    <td>statistics</td>
                    <td>Suggests epsilon from the knee of the k-th neighbor distance curve (this page and <code>php runway knee</code>).</td>
                </tr>
                <tr>
                    <td><strong>LOF</strong></td>
                    <td>local density</td>
                    <td>Study-only contrast: flags points sparser than their own neighborhood (<code>php runway compare</code>).</td>
                </tr>
                <tr>
                    <td><strong>Isolation Forest</strong></td>
                    <td>isolation</td>
                    <td>Study-only contrast: random split trees; anomalies isolate in fewer steps.</td>
                </tr>
            </tbody>
        </table>
    </div>

    <div class="card">
        <h2>Technique performance</h2>
        <p class="muted" style="margin-top: 0;">Measured on the generated dataset (PHP 8.4, same machine). Full methodology in the README.</p>
        <table>
            <thead><tr><th>Technique</th><th>1,400 rows</th><th>5,600 rows</th><th>Scaling</th></tr></thead>
            <tbody>
                <tr><td>DBSCAN</td><td>3.5 s</td><td>58.6 s</td><td>O(n²)</td></tr>
                <tr><td>K-Means (10 restarts)</td><td>0.41 s</td><td>2.60 s</td><td>~O(n)</td></tr>
                <tr><td>PCA → 2D</td><td>~0.5 s</td><td>~1.7 s</td><td>O(n·m²)</td></tr>
                <tr><td>Apriori</td><td>~0.1 s</td><td>~1.0 s</td><td>itemsets</td></tr>
            </tbody>
        </table>
        <p class="muted" style="font-size: .85rem; margin-bottom: 0;">
            ×4 data → DBSCAN ×16.7 slower, K-Means ×6.3. Quality is a different story:
            K-Means looks better on silhouette only because it never reports noise.
        </p>
    </div>
</div>

<div class="card">
    <h2>
        Analysis history
        <span class="tooltip">?
            <span class="tip">Every analysis is persisted to SQLite (analysis_runs +
            log_entries, atomically in one transaction). Click a row to load its
            anomalies below.</span>
        </span>
    </h2>
    <div id="historyTable"></div>
</div>

<div class="card hidden" id="detailCard">
    <h2>Anomalies of run <span class="badge run" id="detailBadge">run #–</span></h2>
    <div id="detailTable"></div>
</div>
{% endblock %}

{% block scripts %}
<script nonce="{{ csp_nonce }}">
const SAMPLE = {
    logs: [
        ...Array.from({length: 12}, (_, i) => ({method: "GET", endpoint: "/users", status_code: 200, response_time: 115 + i, request_size: 1000 + i * 3, hour: 10})),
        ...Array.from({length: 12}, (_, i) => ({method: "POST", endpoint: "/payments", status_code: 201, response_time: 330 + i, request_size: 1500 + i * 4, hour: 12})),
        ...Array.from({length: 10}, (_, i) => ({method: "GET", endpoint: "/health", status_code: 200, response_time: 10 + i, request_size: 150 + i, hour: 13})),
        {method: "GET", endpoint: "/.env", status_code: 404, response_time: 9, request_size: 60, hour: 3},
        {method: "POST", endpoint: "/payments", status_code: 503, response_time: 5200, request_size: 2100, hour: 14},
        {method: "POST", endpoint: "/payments", status_code: 500, response_time: 6100, request_size: 2400, hour: 15},
        {method: "GET", endpoint: "/wp-admin.php", status_code: 404, response_time: 12, request_size: 80, hour: 2}
    ],
    epsilon: 0.35,
    minimum_samples: 5
};

const $ = (id) => document.getElementById(id);

function alertBox(message, kind = "error") {
    const el = $("alert");
    el.className = "alert " + kind;
    el.textContent = message;
    el.style.display = "block";
}

function esc(value) {
    const div = document.createElement("div");
    div.textContent = String(value);
    return div.innerHTML;
}

function anomaliesTable(anomalies) {
    if (!anomalies.length) {
        return '<p class="muted">No anomalies in this run — every log fit a dense cluster.</p>';
    }
    const rows = anomalies.map((a) => `
        <tr>
            <td><span class="badge noise">noise</span></td>
            <td><code>${esc(a.method)}</code></td>
            <td><code>${esc(a.endpoint)}</code></td>
            <td>${esc(a.status_code)}</td>
            <td>${esc(a.response_time)} ms</td>
            <td>${esc(a.request_size)} B</td>
            <td>${esc(a.hour)}h</td>
        </tr>`).join("");
    return `<table>
        <thead><tr><th>verdict</th><th>method</th><th>endpoint</th><th>status</th><th>response</th><th>size</th><th>hour</th></tr></thead>
        <tbody>${rows}</tbody></table>`;
}

function renderRun(data) {
    $("resultCard").classList.remove("hidden");
    $("runBadge").textContent = "run #" + data.run_id;
    $("statSamples").textContent = data.samples;
    $("statClusters").textContent = data.clusters;
    $("statAnomalies").textContent = data.anomalies;
    $("statAnomalies").title = data.anomalies + " noise point(s)";
}

async function fetchAnomalies(runId) {
    const response = await fetch(`{{ base_url }}api/v1/analysis/${runId}`);
    const body = await response.json();
    if (!response.ok) {
        alertBox(body.error ? body.error.message : "Failed to load run " + runId);
        return;
    }
    $("detailCard").classList.remove("hidden");
    $("detailBadge").textContent = "run #" + runId;
    $("detailTable").innerHTML = anomaliesTable(body.data.anomalies);
    $("detailCard").scrollIntoView({behavior: "smooth", block: "nearest"});
}

async function loadHistory() {
    const response = await fetch("{{ base_url }}api/v1/analysis?limit=10");
    const body = await response.json();
    const runs = body.data || [];
    if (!runs.length) {
        $("historyTable").innerHTML = '<p class="muted">No analyses yet — run one above.</p>';
        return;
    }
    const rows = runs.map((r) => `
        <tr>
            <td><a href="#" data-run="${r.id}" class="run-link"><span class="badge run">#${r.id}</span></a></td>
            <td>${esc(r.algorithm)}</td>
            <td>${esc(r.epsilon)}</td>
            <td>${esc(r.minimum_samples)}</td>
            <td>${esc(r.samples)}</td>
            <td>${esc(r.clusters)}</td>
            <td style="color: var(--bad)">${esc(r.anomalies)}</td>
            <td class="muted">${esc(r.finished_at)}</td>
        </tr>`).join("");
    $("historyTable").innerHTML = `<table>
        <thead><tr><th>run</th><th>algorithm</th><th>epsilon</th><th>min samples</th><th>samples</th><th>clusters</th><th>anomalies</th><th>finished</th></tr></thead>
        <tbody>${rows}</tbody></table>`;
    document.querySelectorAll(".run-link").forEach((link) => {
        link.addEventListener("click", (event) => {
            event.preventDefault();
            fetchAnomalies(link.dataset.run);
        });
    });
}

$("loadSample").addEventListener("click", () => {
    $("logs").value = JSON.stringify(SAMPLE, null, 2);
});

$("analyze").addEventListener("click", async () => {
    const button = $("analyze");
    button.disabled = true;
    try {
        let payload;
        try {
            payload = JSON.parse($("logs").value);
        } catch (e) {
            alertBox("Invalid JSON: " + e.message);
            return;
        }
        payload.epsilon = parseFloat($("epsilon").value);
        payload.minimum_samples = parseInt($("minSamples").value, 10);

        const response = await fetch("{{ base_url }}api/v1/analyze", {
            method: "POST",
            headers: {"Content-Type": "application/json", "X-CSRF-Token": csrfToken()},
            body: JSON.stringify(payload)
        });
        const body = await response.json();
        if (!response.ok) {
            alertBox(body.error ? `${body.error.code}: ${body.error.message}` : "Analysis failed");
            return;
        }
        $("alert").style.display = "none";
        renderRun(body.data);
        loadHistory();
        fetchAnomalies(body.data.run_id);
    } catch (e) {
        alertBox("Request failed: " + e.message);
    } finally {
        button.disabled = false;
    }
});

function clusterColor(cluster) {
    return `hsl(${(cluster * 67) % 360} 65% 60%)`;
}

function renderScatter(points) {
    const xs = points.map((p) => p.coordinates[0]);
    const ys = points.map((p) => p.coordinates[1]);
    const pad = (max, min) => Math.max((max - min) * 0.05, 1e-9);
    const [minX, maxX] = [Math.min(...xs), Math.max(...xs)];
    const [minY, maxY] = [Math.min(...ys), Math.max(...ys)];
    const toX = (v) => 4 + ((v - minX) / (maxX - minX + pad(maxX, minX))) * 92;
    const toY = (v) => 96 - ((v - minY) / (maxY - minY + pad(maxY, minY))) * 92;

    const dots = points.map((p) => {
        const fill = p.anomaly ? "var(--bad)" : clusterColor(p.cluster ?? 0);
        const r = p.anomaly ? 1.4 : 1.0;
        return `<circle cx="${toX(p.coordinates[0]).toFixed(2)}" cy="${toY(p.coordinates[1]).toFixed(2)}" r="${r}" fill="${fill}" fill-opacity="0.85"/>`;
    }).join("");

    $("scatter").innerHTML = `
        <svg viewBox="0 0 100 100" style="width: 100%; height: auto; display: block;">
            <line x1="4" y1="96" x2="96" y2="96" stroke="var(--border)" stroke-width="0.4"/>
            <line x1="4" y1="96" x2="4" y2="4" stroke="var(--border)" stroke-width="0.4"/>
            <text x="96" y="99" font-size="3" fill="var(--muted)" text-anchor="end">pc1</text>
            <text x="1" y="7" font-size="3" fill="var(--muted)">pc2</text>
            ${dots}
        </svg>`;
}

function parseInput() {
    const raw = $("logs").value.trim();
    if (raw.startsWith("[")) {
        try {
            const logs = JSON.parse(raw);
            return {logs};
        } catch (e) {
            alertBox("Invalid JSON: " + e.message);
            return null;
        }
    }
    if (!raw) {
        alertBox("Paste logs first (JSON array, CSV dataset or nginx access.log).");
        return null;
    }
    const format = $("format").value;
    return format === "auto" ? {text: raw} : {text: raw, format};
}

function csrfToken() {
    const match = document.cookie.match(/csrf_token=([^;]+)/);
    return match ? match[1] : "";
}

function renderCurve(curve, suggested) {
    if (!curve || curve.length < 2) { $("curveChart").innerHTML = ""; return; }
    const W = 100, H = 60, PAD = 6;
    const maxIdx = curve[curve.length - 1].index;
    const logs = curve.map((p) => Math.log10(Math.max(p.distance, 1e-12)));
    const lo = Math.min(...logs), hi = Math.max(...logs);
    const toX = (i) => PAD + (i / maxIdx) * (W - PAD - 2);
    const toY = (v) => PAD + ((hi - v) / (hi - lo || 1)) * (H - PAD * 2);
    const path = curve.map((p, k) => `${k ? "L" : "M"}${toX(p.index).toFixed(2)},${toY(logs[k]).toFixed(2)}`).join(" ");
    let hint = "";
    if (suggested) {
        const sLog = Math.log10(Math.max(suggested, 1e-12));
        if (sLog >= lo && sLog <= hi) {
            hint = `<line x1="${PAD}" y1="${toY(sLog).toFixed(2)}" x2="${W - 2}" y2="${toY(sLog).toFixed(2)}" stroke="var(--bad)" stroke-width="0.5" stroke-dasharray="2 1.5"/>`;
        }
    }
    $("curveChart").innerHTML = `
        <svg viewBox="0 0 ${W} ${H}" style="width: 100%; height: auto; display: block;">
            <path d="${path}" fill="none" stroke="var(--accent)" stroke-width="0.8"/>
            ${hint}
            <text x="${W - 2}" y="${H - 1}" font-size="3" fill="var(--muted)" text-anchor="end">sample index</text>
            <text x="${PAD}" y="${PAD + 2}" font-size="3" fill="var(--muted)">k-dist (log)</text>
        </svg>`;
}

$("project").addEventListener("click", async () => {
    const button = $("project");
    button.disabled = true;
    try {
        let payload;
        try {
            payload = JSON.parse($("logs").value);
        } catch (e) {
            alertBox("Invalid JSON: " + e.message);
            return;
        }
        payload.epsilon = parseFloat($("epsilon").value);
        payload.minimum_samples = parseInt($("minSamples").value, 10);

        const response = await fetch("{{ base_url }}api/v1/project", {
            method: "POST",
            headers: {"Content-Type": "application/json", "X-CSRF-Token": csrfToken()},
            body: JSON.stringify(payload)
        });
        const body = await response.json();
        if (!response.ok) {
            alertBox(body.error ? `${body.error.code}: ${body.error.message}` : "Projection failed");
            return;
        }
        $("alert").style.display = "none";
        $("vizCard").classList.remove("hidden");
        $("vizBadge").textContent = `${body.data.sample_count} samples`;
        const hint = body.data.suggested_epsilon;
        const curve = body.data.epsilon_curve || {};
        $("vizMeta").innerHTML = `clusters ${body.data.clusters} · anomalies ${body.data.anomalies}` +
            (hint ? ` · knee suggests epsilon ≈ <strong>${hint.toFixed(3)}</strong>
             <span class="muted">(max ${Number(curve.max ?? 0).toFixed(2)}, median ${Number(curve.median ?? 0).toFixed(3)})</span>
             <button class="ghost" id="applyEpsilon">apply to form</button>` : "");
        renderScatter(body.data.points);
        renderCurve(body.data.curve, body.data.suggested_epsilon);
        const apply = $("applyEpsilon");
        if (apply) {
            apply.addEventListener("click", () => { $("epsilon").value = hint.toFixed(3); });
        }
    } catch (e) {
        alertBox("Request failed: " + e.message);
    } finally {
        button.disabled = false;
    }
});

$("logs").value = JSON.stringify(SAMPLE, null, 2);
loadHistory();
</script>
{% endblock %}
